# Copy to backend/.env and fill in real values. Never commit that file.

# --- AI providers (optional) -------------------------------------------------
# At least one complete key + model pair enables AI Insights.
# Providers are tried in this order; the first success answers the request.
AI_PROVIDER_ORDER=groq,gemini,openrouter

GROQ_API_KEY=
GROQ_MODEL=

# gemini-3.5-flash-lite is broadly available; gemini-3.8-flash can return 503
# while Google's capacity is exhausted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2

# --- Deployment --------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Leave empty for
# local development (localhost / 127.0.0.1 on any port).
# Example: https://datafusion.example.com
CORS_ORIGINS=

# Timezone used for dashboard activity and processing-log timestamps.
# Timestamps are stored in UTC; this only affects display. IST default.
APP_TIMEZONE=Asia/Kolkata

# Directory containing the built frontend. Defaults to ../frontend/dist next to
# the backend package; set it when the build lives elsewhere.
FRONTEND_DIST=
